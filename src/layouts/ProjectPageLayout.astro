---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, description, github, website, featureImage } = entry.data;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-5xl mx-auto w-full px-4">
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-3">{title}</h1>
      {description && <p class="text-lg text-gray-600 dark:text-gray-300">{description}</p>}
    </header>

    <!--
      Desktop: sidebar floats right so prose content wraps around it.
      Mobile: sidebar drops below the main content via order utilities on a flex-col wrapper.
    -->
    <div class="flex flex-col md:block">
      <!-- Sidebar: floats right on desktop (content wraps around it); falls to
           bottom via flexbox order on mobile (order-2 means after the content) -->
      <aside
        class="order-2 md:order-none md:float-right md:w-64 md:ml-8 md:mb-6 mt-8 md:mt-0
               rounded-xl border border-gray-200 dark:border-gray-700
               bg-gray-50 dark:bg-gray-800/50 p-5 shrink-0"
      >
        {
          featureImage && (
            <img
              src={featureImage.src}
              alt={title}
              class="w-full rounded-lg mb-4 object-cover"
              width={featureImage.width}
              height={featureImage.height}
            />
          )
        }

        <h2 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-3">
          Project Info
        </h2>

        <ul class="space-y-2 text-sm">
          {
            github && (
              <li>
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-brand-600 dark:text-brand-400 hover:underline"
                >
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                  </svg>
                  GitHub
                </a>
              </li>
            )
          }
          {
            website && (
              <li>
                <a
                  href={website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 text-brand-600 dark:text-brand-400 hover:underline"
                >
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                  Project Site
                </a>
              </li>
            )
          }
        </ul>
      </aside>

      <!-- Main content: renders first on mobile (order-1), flows naturally on desktop -->
      <div class="order-1 md:order-none prose prose-lg dark:prose-invert max-w-none">
        <slot />
      </div>

      <!-- Clearfix so the layout container fully wraps the floated sidebar on desktop -->
      <div class="hidden md:block clear-both"></div>
    </div>

    <footer class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
      <a href="/projects" class="text-brand-600 hover:text-brand-700 dark:text-brand-400 dark:hover:text-brand-300 font-medium text-sm">
        &larr; All Projects
      </a>
    </footer>
  </article>
</BaseLayout>
