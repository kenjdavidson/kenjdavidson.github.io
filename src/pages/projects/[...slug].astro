---
import { getCollection, render } from 'astro:content';
import ProjectPageLayout from '../../layouts/ProjectPageLayout.astro';
import { getProjectSlug } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft && data.page);
  return projects.map((entry) => ({
    params: { slug: getProjectSlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ProjectPageLayout entry={entry}>
  <Content />
</ProjectPageLayout>
